# PharmaPOS Pro — API Environment Variables
# Copy to .env — NEVER commit .env

# App
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL — from Supabase dashboard: Settings → API
SUPABASE_URL=https://xjzrtgneqxeayvhghzap.supabase.co
# Publishable key (formerly "anon key") — safe for server-side code with RLS enforced
# Found at: Supabase dashboard → Settings → API → Publishable key
SUPABASE_ANON_KEY=sb_publishable_r_rpdXwMYTlzhO_ALJYvYw_qleGgAJD

# Secret key (formerly "service_role key") — NEVER expose to client, bypasses RLS
# Found at: Supabase dashboard → Settings → API → Secret keys
SUPABASE_SERVICE_ROLE_KEY=sb_secret_gBdKodtCsF9KpzPPJyw2Tw_zQiJKBFM

# ─── Database (PostgreSQL via Supabase) ──────────────────────────────────────
# Transaction Pooler — used by the API at runtime (port 6543)
# From: Supabase dashboard → Settings → Database → Connection string → URI
# Use "Transaction" mode for the pooler URL
DATABASE_URL=postgresql://postgres.xjzrtgneqxeayvhghzap:eZx-UiC/8z.d+7@aws-1-us-west-1.pooler.supabase.com:6543/postgres
# Direct connection — used by TypeORM CLI for migrations ONLY (port 5432)
# From: Supabase dashboard → Settings → Database → Connection string → Direct
DATABASE_DIRECT_URL=postgresql://postgres:eZx-UiC/8z.d+7@db.xjzrtgneqxeayvhghzap.supabase.co:5432/postgres

# ─── Redis 7 ─────────────────────────────────────────────────────────────────
# For local dev: docker-compose up redis
# For prod: Upstash Redis (serverless, free tier available)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=rediss://:<password>@<host>:6380  # use this for Upstash TLS

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production_refresh

# ─── PII Encryption (Ghana Data Protection Act 2012) ─────────────────────────
# AES-256-GCM key for encrypting staff PII (phone, address, Ghana Card, DOB)
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# MUST be exactly 64 hex characters (32 bytes). Rotate via key-versioning — never delete old key.
PII_ENCRYPTION_KEY=5f81357aa53916d0a16844e3fd77064b5f397d99f919278475b02f7de574ec2b

# ─── AWS S3 (Rx PDFs, product images, reports) ───────────────────────────────
# Or use Supabase Storage (set USE_SUPABASE_STORAGE=true below)
USE_SUPABASE_STORAGE=false
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=pharmapos-dev

# ─── OpenAI (GPT-4o — invoice extraction, drug interaction AI) ───────────────
OPENAI_API_KEY=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

# ─── Hubtel SMS (Ghana-native — NCA pre-approved Sender ID) ──────────────────
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# ─── MTN MoMo API ────────────────────────────────────────────────────────────
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
MOMO_ENVIRONMENT=sandbox

# ─── GMDC API (prescriber licence validation) ────────────────────────────────
GMDC_API_URL=https://api.gmdc.gov.gh
GMDC_API_KEY=
# Optional: full URL template; must include {licence} placeholder (HTTP GET, JSON body parsed by API)
# GMDC_LICENCE_URL_TEMPLATE=https://api.gmdc.gov.gh/v1/prescriber-licences/{licence}

# ─── Drug interactions (RxNorm ingredient match + OpenAI clinical pass) ─────
# NIH discontinued the RxNav DDI API in Jan 2024 — use OPENAI for analysis, or set off
DRUG_INTERACTION_PROVIDER=off
# OPENAI_DRUG_INTERACTION_MODEL=gpt-4o-mini

# ─── Email Provider (transactional emails) ───────────────────────────────────
# Options: resend, sendgrid, ses
EMAIL_PROVIDER=resend
# Resend API key — from https://resend.com/api-keys
EMAIL_API_KEY=re_j9Kfgx5b_aXgvkuRYvDUvmEdinucKfmLx
# Sender identity. For Resend quick tests use onboarding@resend.dev,
# then switch to your verified domain sender for production.
EMAIL_FROM=PharmaPOS <onboarding@resend.dev>
# Or SendGrid: https://app.sendgrid.com/settings/api_keys
# Or AWS SES: requires @aws-sdk/client-ses installed

# ─── WhatsApp Alerts (optional) ───────────────────────────────────────────────
# Webhook endpoint that accepts {to, message, channel}. Leave empty to disable WhatsApp.
WHATSAPP_WEBHOOK_URL=
# If true and WhatsApp is not configured, sendWhatsApp falls back to SMS.
WHATSAPP_FALLBACK_TO_SMS=true

{
  "name": "api",
  "version": "0.1.0",
  "description": "PharmaPOS Pro production API — NestJS 11 + GraphQL (Apollo) + TypeORM/PostgreSQL. Branch-scoped pharmacy operations: POS sales, inventory & stock alerts, prescriptions/dispensing, supplier intelligence, accounting (P&L, VAT, invoices), audit/compliance, real-time stock subscriptions (Redis), file storage (S3-compatible), notifications, and health checks. Intended for regulated retail pharmacy deployments (e.g. Ghana FDA / GRA–aligned reporting).",
  "author": "Hanson Peprah <hanson.peprah@advansis.com> Advansis Technologies",
  "license": "UNLICENSED",
  "private": true,
  "keywords": [
    "pharmapos",
    "pharmacy",
    "pos",
    "nestjs",
    "graphql",
    "typeorm",
    "postgresql",
    "ghana",
    "compliance",
    "inventory",
    "production"
  ],
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "nest build && node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:compliance": "jest --testPathPattern=test/compliance",
    "migration:run": "ts-node --project tsconfig.json -r dotenv/config node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "ts-node --project tsconfig.json -r dotenv/config node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:generate": "ts-node --project tsconfig.json -r dotenv/config node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "db:seed": "ts-node --project tsconfig.json -r dotenv/config src/database/seed.ts",
    "db:import-products": "cd ../../scripts/migration && python import-products.py"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.600.0",
    "@nestjs/apollo": "^13.2.4",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.17",
    "@nestjs/graphql": "^13.2.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.0",
    "@supabase/supabase-js": "^2.43.5",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.8.4",
    "cache-manager": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "graphql": "^16.8.2",
    "graphql-redis-subscriptions": "^2.6.1",
    "graphql-ws": "^5.16.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "nest-winston": "^1.9.7",
    "openai": "^4.52.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "winston": "^3.13.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/testing": "^11.1.17",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.4",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "pg": "^8.20.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.9.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "../test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
